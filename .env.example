# ─────────────────────────────────────────────────────────────
# ZAVERA — Environment variables example
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real ".env" file (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Supabase project URL (backend endpoint for the generated app)
VITE_SUPABASE_URL="https://your-project.lovable.cloud"

# Supabase publishable (anon) key — safe for the browser bundle
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"

# Supabase project ID (used by the Lovable Cloud integration)
VITE_SUPABASE_PROJECT_ID="your_project_id"
